# Rewards (block 20180). Copy to the deploy env file; secrets as *_FILE.
REWARDS_HTTP_ADDR=0.0.0.0:20180
# Postgres, database "rewards". Migrations apply at start-up.
REWARDS_DATABASE_URL_FILE=/run/rewards/database.url
# The account core: its gRPC and HTTP (whoami), and the credential this service presents there.
REWARDS_CORE_ADDRESS=openpak-account:20001
REWARDS_CORE_HTTP_URL=http://openpak-account:20000
REWARDS_CORE_INTERNAL_KEY_FILE=/run/rewards/core.key
# What the website and adapters present on /internal/v1 (X-Internal-Key), >= 32 characters.
REWARDS_INTERNAL_KEY_FILE=/run/rewards/internal.key
# What the website's admin presents on /internal/v1/admin (X-Admin-Key), >= 32 characters,
# different from the internal key.
REWARDS_ADMIN_KEY_FILE=/run/rewards/admin.key
# Where reward files live (a volume).
REWARDS_ASSET_DIR=/data/assets
# How often the account core is read for play time (Go duration, >= 30s), which namespaces
# (adapter names in the core) are read, and "off" to run without accrual.
REWARDS_POLL_INTERVAL=5m
REWARDS_NAMESPACES=switch,wiiu,3ds,wfc,np,xbox360,xbox
REWARDS_ACCRUAL=on
# Browser origins allowed to call /v1 directly (comma separated).
REWARDS_CORS_ORIGINS=https://openpak.org
# Optional economy knobs (defaults in docs/design.md): REWARDS_PLAY_DAILY_CAP,
# REWARDS_PLAY_TITLE_DAILY_CAP, REWARDS_NEW_TITLE_DAILY_CAP, REWARDS_FRIEND_LIFETIME_CAP,
# REWARDS_SECONDS_PER_POINT (>= 60).
